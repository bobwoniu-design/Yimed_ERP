{
 "doctype": "DocType",
 "name": "Connector Outbound Message",
 "module": "Jackyun Integration",
 "autoname": "OUT-.YYYY.-.#####",
 "engine": "InnoDB",
 "track_changes": 1,
 "title_field": "external_id",
 "sort_field": "modified",
 "sort_order": "DESC",
 "field_order": ["connector_connection", "connection", "platform", "adapter_key", "resource", "operation", "status", "reference_section", "reference_doctype", "reference_name", "external_id", "operation_identity", "idempotency_key", "payload_digest", "origin_section", "source_system", "source_event_id", "origin_message", "payload_section", "payload", "preflight_data", "request_data", "attempt_section", "attempts", "max_attempts", "next_retry_at", "last_attempt_at", "acknowledged_at", "uncertain_since", "probe_attempts", "last_probe_at", "receipt_section", "response_context_id", "response_data", "probe_data", "error_message", "conflict_status", "conflict_details"],
 "fields": [
  {"fieldname": "connector_connection", "label": "通用连接", "fieldtype": "Link", "options": "Connector Connection", "in_list_view": 1},
  {"fieldname": "connection", "label": "吉客云连接（兼容）", "fieldtype": "Link", "options": "Jackyun Connection", "in_list_view": 1, "description": "历史兼容字段；新平台使用通用连接。"},
  {"fieldname": "platform", "label": "平台", "fieldtype": "Data", "read_only": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "adapter_key", "label": "适配器", "fieldtype": "Data", "read_only": 1},
  {"fieldname": "resource", "label": "资源类型", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "operation", "label": "操作", "fieldtype": "Select", "options": "Create\nUpdate\nCancel\nAudit\nQuery", "reqd": 1, "in_list_view": 1},
  {"fieldname": "status", "label": "状态", "fieldtype": "Select", "options": "Preflight\nPending\nProcessing\nSucceeded\nRetrying\nFailed\nBlocked\nConflict\nUncertain", "reqd": 1, "default": "Preflight", "in_list_view": 1, "in_standard_filter": 1},
  {"fieldname": "reference_section", "label": "业务引用与幂等", "fieldtype": "Section Break"},
  {"fieldname": "reference_doctype", "label": "ERPNext单据类型", "fieldtype": "Link", "options": "DocType"},
  {"fieldname": "reference_name", "label": "ERPNext历史单据编号", "fieldtype": "Data", "read_only": 1, "in_list_view": 1, "description": "保留发起同步时的单据编号；源单据删除后审计记录仍可继续处理。"},
  {"fieldname": "external_id", "label": "外部ID", "fieldtype": "Data", "in_list_view": 1},
  {"fieldname": "operation_identity", "label": "操作身份", "fieldtype": "Data", "read_only": 1},
  {"fieldname": "idempotency_key", "label": "幂等键", "fieldtype": "Data", "unique": 1, "reqd": 1},
  {"fieldname": "payload_digest", "label": "报文摘要", "fieldtype": "Data", "read_only": 1},
  {"fieldname": "origin_section", "label": "来源与回环保护", "fieldtype": "Section Break"},
  {"fieldname": "source_system", "label": "来源系统", "fieldtype": "Data", "description": "事件最初产生的平台或系统。"},
  {"fieldname": "source_event_id", "label": "来源事件ID", "fieldtype": "Data"},
  {"fieldname": "origin_message", "label": "上游消息", "fieldtype": "Link", "options": "Connector Outbound Message", "read_only": 1},
  {"fieldname": "payload_section", "label": "请求", "fieldtype": "Section Break"},
  {"fieldname": "payload", "label": "业务报文", "fieldtype": "Code", "options": "JSON", "reqd": 1},
  {"fieldname": "preflight_data", "label": "预检结果", "fieldtype": "Code", "options": "JSON", "read_only": 1},
  {"fieldname": "request_data", "label": "实际请求快照", "fieldtype": "Code", "options": "JSON", "read_only": 1},
  {"fieldname": "attempt_section", "label": "尝试与重试", "fieldtype": "Section Break"},
  {"fieldname": "attempts", "label": "写入尝试次数", "fieldtype": "Int", "read_only": 1, "default": "0"},
  {"fieldname": "max_attempts", "label": "最大尝试次数", "fieldtype": "Int", "default": "5", "reqd": 1},
  {"fieldname": "next_retry_at", "label": "下次重试时间", "fieldtype": "Datetime", "in_list_view": 1},
  {"fieldname": "last_attempt_at", "label": "最近写入尝试", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "acknowledged_at", "label": "回执时间", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "uncertain_since", "label": "不确定起始时间", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "probe_attempts", "label": "Probe次数", "fieldtype": "Int", "read_only": 1, "default": "0"},
  {"fieldname": "last_probe_at", "label": "最近Probe时间", "fieldtype": "Datetime", "read_only": 1},
  {"fieldname": "receipt_section", "label": "回执与冲突", "fieldtype": "Section Break"},
  {"fieldname": "response_context_id", "label": "Context ID", "fieldtype": "Data", "read_only": 1},
  {"fieldname": "response_data", "label": "回执报文", "fieldtype": "Code", "options": "JSON", "read_only": 1},
  {"fieldname": "probe_data", "label": "Probe结果", "fieldtype": "Code", "options": "JSON", "read_only": 1},
  {"fieldname": "error_message", "label": "错误信息", "fieldtype": "Long Text", "read_only": 1},
  {"fieldname": "conflict_status", "label": "冲突处理", "fieldtype": "Select", "options": "\nNo Conflict\nSource Wins\nERPNext Wins\nManual Review", "read_only": 1},
  {"fieldname": "conflict_details", "label": "冲突明细", "fieldtype": "Long Text", "read_only": 1}
 ],
 "permissions": [{"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1}]
}
